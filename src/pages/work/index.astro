---
import { env } from "cloudflare:workers";
import Card from "../../components/Card.astro";
import Layout from "../../layouts/Layout.astro";
import { getWork } from "../../lib/notion";
import type { WorkItem } from "../../lib/types/notion";

const kv = (env as any).SESSION;
const work = await getWork(kv);

const experience = work.filter(
  (item: WorkItem) => item.category === "work-experience",
);
const projects = work.filter((item: WorkItem) => item.category === "project");
---

<Layout title="work">
  <h1 class="mb-4">work</h1>
  <section class="mb-10">
    <h4 class="text-zinc-500">experience</h4>
    {experience.map((item: WorkItem) => <Card {...item} type="work" />)}
  </section>
  <section>
    <h4 class="text-zinc-500">projects</h4>
    {projects.map((item: WorkItem) => <Card {...item} />)}
  </section>
</Layout>
